# Copy to .env; never commit live credentials.
# Both bind addresses should be NAS interface IPs accessible on your LAN.
ADMIN_BIND=0.0.0.0
MEDIA_BIND=0.0.0.0
ADMIN_PORT=8080
MEDIA_PORT=8081
APP_BASE_URL=http://192.168.1.100:8080
MEDIA_BASE_URL=http://192.168.1.100:8081
TZ=Europe/Lisbon
# Absolute paths on OMV are recommended. App runs as UID/GID 10001.
DATA_DIR=./data
MEDIA_DIR=./media
# Create the administrator in the web UI; restrict access during first-run setup.
